# Frontend environment variables (Vite)
# Copy to `.env.local` for local development, or set these in your hosting provider (Vercel).
# Do NOT put server secrets (like SUPABASE_SERVICE_ROLE_KEY) in the frontend.

# Backend API base URL
# Local example:
# VITE_API_URL=http://localhost:5000
# Render example:
# VITE_API_URL=https://gd-10-0-backend-1.onrender.com

# Supabase (public) config used by the browser
# You can keep these in code, but env is recommended for easy changes.
# VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
